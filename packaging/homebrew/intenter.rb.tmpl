# REFERENCE ONLY — this file is not used to publish anything.
#
# The real formula is generated by GoReleaser at release time from the `brews:`
# block in .goreleaser.yaml and committed to the Vadym903/homebrew-tap
# repository. This file documents the shape that block produces, so the
# generated output can be reviewed against something.
#
# To see the actual formula before a release:
#   goreleaser release --snapshot --skip=publish --clean
#   cat dist/homebrew/Formula/intenter.rb
class Intenter < Formula
  desc "Semantic runtime permission layer for AI coding agents"
  homepage "https://github.com/Vadym903/Intenter"
  version "{{ .Version }}"
  license "PolyForm-Noncommercial-1.0.0"

  on_macos do
    on_arm do
      url "https://github.com/Vadym903/Intenter/releases/download/v{{ .Version }}/intenter_{{ .Version }}_darwin_arm64.tar.gz"
      sha256 "{{ .Sha256DarwinArm64 }}"
    end
    on_intel do
      url "https://github.com/Vadym903/Intenter/releases/download/v{{ .Version }}/intenter_{{ .Version }}_darwin_amd64.tar.gz"
      sha256 "{{ .Sha256DarwinAmd64 }}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/Vadym903/Intenter/releases/download/v{{ .Version }}/intenter_{{ .Version }}_linux_arm64.tar.gz"
      sha256 "{{ .Sha256LinuxArm64 }}"
    end
    on_intel do
      url "https://github.com/Vadym903/Intenter/releases/download/v{{ .Version }}/intenter_{{ .Version }}_linux_amd64.tar.gz"
      sha256 "{{ .Sha256LinuxAmd64 }}"
    end
  end

  def install
    bin.install "intenter"
  end

  def caveats
    <<~EOS
      Finish the installation with:
        intenter setup claude
    EOS
  end

  test do
    assert_match "intenter", shell_output("#{bin}/intenter version")
  end
end
